# Uma LLM provider configuration
# Uma uses an OpenAI-compatible chat-completions interface, so any
# OpenAI-compatible provider works (OpenAI itself, Groq, Together, Fireworks,
# a local vLLM/Ollama-with-OpenAI-shim endpoint, etc).

# Required: API key for the provider.
UMA_LLM_API_KEY=sk-...

# Required: model name exactly as the provider expects it.
UMA_LLM_MODEL=gpt-4o-mini

# Optional: base URL. Defaults to OpenAI's API if unset.
# Examples:
#   OpenAI:            https://api.openai.com/v1
#   Groq:               https://api.groq.com/openai/v1
#   Together AI:        https://api.together.xyz/v1
#   Local (vLLM/Ollama): http://localhost:11434/v1
UMA_LLM_BASE_URL=https://api.openai.com/v1

# Optional: generation parameters used identically by both the baseline and
# the Uma experiment.
UMA_LLM_TEMPERATURE=0.0
UMA_LLM_MAX_TOKENS=400

# Optional: override the local cross-encoder used for filtering.
UMA_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: pricing overrides for cost estimation, in USD per 1M tokens.
# If unset, Uma will only display raw token counts and label cost as
# "not available" rather than guessing. Look up your provider/model's
# current published pricing before setting these — do not guess.
#
# Example (Gemini 3.1 Flash-Lite, Gemini Developer API standard tier,
# text I/O, verified against https://ai.google.dev/gemini-api/docs/pricing
# on 2026-08-09 — re-check before relying on it, providers change pricing):
#   UMA_LLM_INPUT_PRICE_PER_1M=0.25
#   UMA_LLM_OUTPUT_PRICE_PER_1M=1.50
UMA_LLM_INPUT_PRICE_PER_1M=
UMA_LLM_OUTPUT_PRICE_PER_1M=

# Optional but recommended once you've run `uma judge` at least once (which
# caches the cross-encoder weights locally): set this to skip the network
# round-trip Hugging Face Hub does to check for model updates on every load.
# Removes any dependency on internet access for the filtering step itself.
# HF_HUB_OFFLINE=1
